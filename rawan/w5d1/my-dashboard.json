      },
      "pluginVersion": "11.4.0",
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(\r\n  0.95,\r\n  sum by (le) (\r\n    rate(vllm:time_to_first_token_seconds_bucket{job=\"serving\"}[5m])\r\n  )\r\n)",
          "legendFormat": "__auto",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "p95 TTFT over time",
      "type": "timeseries"
    },
